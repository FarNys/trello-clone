generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String         @id @default(cuid())
  name                    String
  email                   String         @unique
  passwordHash            String
  role                    UserRole       @default(USER)
  createdTasks            Task[]         @relation("CreatedTasks")
  assignedTasks           Task[]         @relation("AssignedTasks")
  taskActivitiesAsActor   TaskActivity[] @relation("TaskActivityActor")
  taskActivitiesAssignee  TaskActivity[] @relation("TaskActivityAssignee")
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
}

enum UserRole {
  ADMIN
  USER
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model Task {
  id          String         @id @default(cuid())
  title       String
  description String?
  status      TaskStatus     @default(NEW)
  workspaceId String
  creatorId   String
  assigneeId  String?
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User           @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee    User?          @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  activities  TaskActivity[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([workspaceId])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([status])
}

enum TaskStatus {
  BACKLOG
  NEW
  IN_PROGRESS
  PREVIEW
  DONE
}

model TaskActivity {
  id         String           @id @default(cuid())
  taskId     String
  actorId    String?
  assigneeId String?
  type       TaskActivityType
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  createdAt  DateTime         @default(now())
  task       Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor      User?            @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  assignee   User?            @relation("TaskActivityAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([actorId])
  @@index([assigneeId])
  @@index([type])
}

enum TaskActivityType {
  CREATED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
}
